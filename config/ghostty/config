theme = Black Metal (Marduk)
font-family = "Berkeley Mono"
font-size = 14

window-padding-x = 40
window-padding-y = 20
window-colorspace = display-p3

confirm-close-surface = false
macos-titlebar-style = tabs
mouse-hide-while-typing = true
adjust-cursor-thickness = 300%
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Per-machine settings (ignored by Git). Loaded last so they can override
# shared values such as font-size without making the dotfiles diverge.
config-file = ?config.local
